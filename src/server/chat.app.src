{application, chat,
 [{description, "OTP TCP chat server"},
  {vsn, "1.2.0"},
  {registered, [chat_sup,
                role_online_server,
                map_server,
                main_channel_server,
                public_channel_server_1,
                public_channel_server_2,
                public_channel_server_3,
                public_channel_server_4,
                public_channel_server_5,
                public_channel_server_6,
                public_channel_server_7,
                public_channel_server_8,
                public_channel_server_9,
                map_channel_server_1,
                map_channel_server_2,
                world_broadcast_worker_1,
                world_broadcast_worker_2,
                world_broadcast_worker_3,
                world_broadcast_worker_4,
                world_broadcast_worker_5,
                world_broadcast_worker_6,
                world_broadcast_worker_7,
                world_broadcast_worker_8,
                channel_sup,
                role_sup,
                chat_listener]},
  {mod, {chat_app, []}},
  {applications, [kernel, stdlib]},
  {env, [{port, 5555}]},
  {modules, [chat_app,
             chat_sup,
             role_online_server,
             map_server,
             channel_sup,
             channel_server,
             world_broadcast_worker,
             role_sup,
             role_server,
             chat_listener,
             chat_metrics,
             chat_server_protocol,
             chat_client_sup,
             chat_load_test,
             chat_client,
             chat_client_protocol]}]}.
