{application, chat,
 [{description, "OTP TCP chat server"},
  {vsn, "1.1.0"},
  {registered, [chat_sup,
                role_online_server,
                channel_manager,
                channel_sup,
                role_sup,
                chat_listener]},
  {mod, {chat_app, []}},
  {applications, [kernel, stdlib]},
  {env, [{port, 5555}]},
  {modules, [chat_app,
             chat_sup,
             role_online_server,
             channel_manager,
             channel_sup,
             channel_server,
             world_broadcast_worker,
             role_sup,
             role_server,
             chat_listener,
             chat_metrics,
             chat_server_protocol,
             chat_client_sup,
             client,
             chat_client,
             chat_client_protocol]}]}.
