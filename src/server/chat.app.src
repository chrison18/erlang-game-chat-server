                public_channel_server_6,
                public_channel_server_7,
                public_channel_server_8,
                public_channel_server_9,
                map_channel_server_1,
                map_channel_server_2,
                map_channel_server_3,
                world_broadcast_worker_1,
                world_broadcast_worker_2,
                world_broadcast_worker_3,
                world_broadcast_worker_4,
                world_broadcast_worker_5,
                world_broadcast_worker_6,
                world_broadcast_worker_7,
                world_broadcast_worker_8,
                nearby_broadcast_worker_1,
                nearby_broadcast_worker_1_2,
                nearby_broadcast_worker_2,
                nearby_broadcast_worker_2_2,
                nearby_broadcast_worker_3,
                nearby_broadcast_worker_3_2,
                map_broadcast_worker_1_1,
                map_broadcast_worker_1_2,
                map_broadcast_worker_1_3,
                map_broadcast_worker_1_4,
                map_broadcast_worker_1_5,
                map_broadcast_worker_1_6,
                map_broadcast_worker_1_7,
                map_broadcast_worker_1_8,
                map_broadcast_worker_2_1,
                map_broadcast_worker_2_2,
                map_broadcast_worker_2_3,
                map_broadcast_worker_2_4,
